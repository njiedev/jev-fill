{
  "manifest_version": 3,
  "name": "Jev Fill",
  "version": "0.1.0",
  "description": "Review-first job application autofill from one pasted profile block.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": ["http://127.0.0.1:8788/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Jev Fill"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
